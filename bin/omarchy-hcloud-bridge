#!/usr/bin/python3
"""Keyring-backed bridge between the Omarchy shell and the Hetzner Cloud API.

The shell never sees a token. Tokens live in the login keyring under
service `omarchy-hcloud`, keyed by a project label the user picks, and only
this process ever holds one in memory. Nothing secret is passed on argv:
`/proc/<pid>/cmdline` is world-readable, so a token there would leak to every
local user. Labels are not secret and travel on argv; the token itself is read
from the keyring (`servers`) or from stdin (`store`).

Hetzner Cloud API tokens are scoped to a single project and there is no
endpoint that enumerates projects, so "all my projects" is modelled as one
labelled token per project.

Usage:
  omarchy-hcloud-bridge servers [LABEL ...]   one JSON document, one entry per label
  omarchy-hcloud-bridge store LABEL           token on stdin, one line
  omarchy-hcloud-bridge remove LABEL
  omarchy-hcloud-bridge labels                labels currently in the keyring
  omarchy-hcloud-bridge sync-ssh              job JSON on stdin, writes ~/.ssh/config
  omarchy-hcloud-bridge metrics LABEL ID [WINDOW]
                                              cpu / network / disk for one server;
                                              WINDOW in seconds, default one hour
  omarchy-hcloud-bridge storage-boxes LABEL   storage boxes visible to that token
  omarchy-hcloud-bridge uninstall             forget every token and take the
                                              hcloud-sync block out of ~/.ssh/config

  --demo anywhere on the line answers from demo/fleet.json instead of the
  keyring and the API, and refuses to touch either. The ssh sync still
  writes, so the block can be pictured too; the previous config is backed
  up as always and the next real sync puts it back.
"""

import concurrent.futures
import datetime
import ipaddress
import json
import math
import os
import re
import stat
import tempfile
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEMO_FILE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "demo", "fleet.json")
DEMO = False
SERVICE = "omarchy-hcloud"
# A fixed path, not a PATH lookup. This process holds tokens, and the one
# thing it hands them to must not be whatever a writable directory earlier in
# PATH happens to call secret-tool.
SECRET_TOOL = "/usr/bin/secret-tool"

# Ceilings. Everything that comes in from outside — an HTTP body, a page of
# results, a line of stdin, a file on disk — is read to its limit plus one byte
# and refused if that byte is there, so a broken or hostile source cannot make
# this process, or the shell that waits for its output, grow without bound.
MAX_BODY = 4 * 1024 * 1024          # one HTTP response body
MAX_ERROR_BODY = 64 * 1024          # an HTTP error body
MAX_ITEMS = 2000                    # servers, volumes or boxes per project
MAX_LIST_BYTES = 16 * 1024 * 1024   # all pages of one list together
MAX_SAMPLES = 2000                  # points in one metrics series
MAX_STDIN = 256 * 1024              # a sync job on stdin
MAX_TOKEN = 4 * 1024                # a token on stdin (Hetzner's are 64 chars)
MAX_SSH_CONFIG = 1024 * 1024        # ~/.ssh/config
MAX_DEMO_FILE = 2 * 1024 * 1024     # demo/fleet.json
MAX_STRING = 256                    # any string carried into the output
MAX_LABELS = 64                     # label pairs per server
# The real file, not the path. People keep ~/.ssh/config as a symlink into a
# dotfiles checkout, and an atomic replace of the path would swap the link for
# a plain file and leave the checkout untouched.
SSH_CONFIG = os.path.realpath(os.path.expanduser("~/.ssh/config"))
SSH_BACKUP = SSH_CONFIG + ".hcloud-sync.bak"
# What may go into a Host line. Server names come back from the API, which
# promises RFC 1123 hostnames, but the file this writes is executed by ssh:
# a stray newline in any field would smuggle in a ProxyCommand. Nothing is
# written unless every field passes.
ALIAS_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")
NO_WHITESPACE_RE = re.compile(r"^\S*$")
BLOCK_START = "# --- hcloud-sync START ---"
BLOCK_END = "# --- hcloud-sync END ---"
BLOCK_RE = re.compile(
    r"^%s$.*?^%s$" % (re.escape(BLOCK_START), re.escape(BLOCK_END)),
    re.DOTALL | re.MULTILINE,
)
API = "https://api.hetzner.cloud/v1"
SERVERS = API + "/servers"
VOLUMES = API + "/volumes"
# Storage Boxes are absent from the old Cloud API — every spelling of
# /v1/storage_boxes answers 404 there — but Hetzner's newer unified API serves
# them, and to the same project token. No second credential needed.
UNIFIED = "https://api.hetzner.com/v1"
STORAGE_BOXES = UNIFIED + "/storage_boxes"
PER_PAGE = 100
# Hetzner answers in well under a second; anything past this is a dead network
# and the panel would rather show that than keep a stale spinner. A single slow
# answer is retried once before it counts, since one read timing out in an
# otherwise fine minute was taking whole projects off the list.
TIMEOUT = 15
ATTEMPTS = 2
# Projects are fetched side by side, so a slow one does not hold up the rest,
# and so are the three requests a project is made of.
WORKERS = 4
# Storage boxes live on a different host and are the least of what the panel
# shows. They get one short try; a slow answer there must not hold the list.
BOX_TIMEOUT = 6
BOX_ATTEMPTS = 1
# A runaway `next_page` would otherwise loop forever against a broken API.
MAX_PAGES = 50


def emit(payload):
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 0


def fail(message, code=2):
    emit({"ok": False, "error": message})
    return code


def secret_tool():
    if not os.path.isfile(SECRET_TOOL) or not os.access(SECRET_TOOL, os.X_OK):
        raise RuntimeError("%s not found — install libsecret" % SECRET_TOOL)
    return SECRET_TOOL


def read_capped(stream, limit, what):
    """Read at most `limit` bytes; refuse rather than truncate anything longer."""
    data = stream.read(limit + 1)
    if data is None:
        return b""
    if len(data) > limit:
        raise ValueError("%s exceeds %d bytes" % (what, limit))
    return data


def read_file_capped(path, limit, what):
    with open(path, "rb") as handle:
        return read_capped(handle, limit, what).decode("utf-8")


def clip(value, limit=MAX_STRING):
    """A string from outside, cut to a length the panel can lay out."""
    if value is None:
        return None
    text = str(value)
    return text if len(text) <= limit else text[:limit - 1] + "…"


def check_label(label):
    """A keyring key travels on secret-tool's command line as a positional
    attribute value; one that starts with a dash would be parsed as an option."""
    if not label or label.startswith("-") or label.strip() != label:
        raise ValueError("Invalid label %r" % label)
    return label


def lookup_token(label):
    """Return the token for `label`, or None when the keyring has no entry."""
    check_label(label)
    result = subprocess.run(
        [secret_tool(), "lookup", "service", SERVICE, "account", label],
        capture_output=True,
        text=True,
    )
    # secret-tool exits non-zero on a miss and prints nothing; a hit has no
    # trailing newline, so only strip whitespace we know we did not want.
    if result.returncode != 0:
        return None
    token = result.stdout.strip()
    return token or None


def store_token(label, token):
    check_label(label)
    subprocess.run(
        [
            secret_tool(),
            "store",
            "--label=Hetzner Cloud (%s)" % label,
            "service",
            SERVICE,
            "account",
            label,
        ],
        input=token,
        text=True,
        check=True,
    )


def remove_token(label):
    check_label(label)
    subprocess.run(
        [secret_tool(), "clear", "service", SERVICE, "account", label],
        capture_output=True,
        text=True,
        check=True,
    )


def stored_labels():
    result = subprocess.run(
        [secret_tool(), "search", "--all", "service", SERVICE],
        capture_output=True,
        text=True,
    )
    labels = []
    for line in result.stdout.splitlines():
        line = line.strip()
        if line.startswith("attribute.account = "):
            value = line.split(" = ", 1)[1]
            if value and value not in labels:
                labels.append(value)
    return labels


def is_timeout(error):
    if isinstance(error, (TimeoutError, socket.timeout)):
        return True
    return isinstance(error, urllib.error.URLError) and isinstance(
        error.reason, (TimeoutError, socket.timeout))


def get_json(url, token, timeout=TIMEOUT, attempts=ATTEMPTS):
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": "Bearer " + token,
            "Accept": "application/json",
            "User-Agent": "omarchy-hcloud",
        },
    )
    for attempt in range(attempts):
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                body = read_capped(response, MAX_BODY, "API response")
                return json.loads(body.decode("utf-8"))
        except Exception as error:  # noqa: BLE001 - only a timeout earns a retry
            if is_timeout(error) and attempt + 1 < attempts:
                continue
            raise


def timed(work):
    """Run `work()`, returning (result, error, milliseconds) — never raising.

    The panel and anyone running the bridge by hand get to see which request
    is the slow one, which is the question whenever the list takes a while.
    """
    started = time.monotonic()
    try:
        return work(), None, int((time.monotonic() - started) * 1000)
    except Exception as error:  # noqa: BLE001 - reported, not raised
        return None, error, int((time.monotonic() - started) * 1000)


def in_parallel(jobs):
    """Run the named callables side by side; {name: (result, error, ms)}."""
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(jobs)) as pool:
        futures = {name: pool.submit(timed, work) for name, work in jobs.items()}
        return {name: future.result() for name, future in futures.items()}


def fetch_all(url, token, key, timeout=TIMEOUT, attempts=ATTEMPTS):
    """Walk `meta.pagination.next_page` until Hetzner stops handing out pages,
    within a ceiling on pages, records and bytes."""
    items = []
    total_bytes = 0
    page = 1
    for _ in range(MAX_PAGES):
        body = get_json("%s?per_page=%d&page=%d" % (url, PER_PAGE, page), token,
                        timeout=timeout, attempts=attempts)
        if not isinstance(body, dict):
            raise ValueError("API response is not an object")
        chunk = body.get(key) or []
        if not isinstance(chunk, list):
            raise ValueError("API response field %r is not a list" % key)
        total_bytes += len(json.dumps(chunk))
        if total_bytes > MAX_LIST_BYTES:
            raise ValueError("%s list exceeds %d bytes" % (key, MAX_LIST_BYTES))
        items.extend(chunk)
        if len(items) > MAX_ITEMS:
            raise ValueError("more than %d %s in one project" % (MAX_ITEMS, key))
        pagination = (body.get("meta") or {}).get("pagination") or {}
        next_page = pagination.get("next_page")
        if not isinstance(next_page, int) or next_page <= page:
            break
        page = next_page
    return items


def as_dict(value):
    return value if isinstance(value, dict) else {}


def as_list(value):
    return value if isinstance(value, list) else []


def number(value):
    """An int or float from outside, or None; never a string or a NaN."""
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float) and math.isfinite(value):
        return value
    return None


def project_server(raw):
    """The fields the panel reads, and nothing else, each cut to size.

    What goes back to the shell is a fixed shape of bounded strings and
    numbers. A field the API grows tomorrow, or a hostile one, never reaches
    the QML side.
    """
    server = as_dict(raw)
    public_net = as_dict(server.get("public_net"))
    ipv4 = as_dict(public_net.get("ipv4"))
    ipv6 = as_dict(public_net.get("ipv6"))
    server_type = as_dict(server.get("server_type"))
    datacenter = as_dict(server.get("datacenter"))
    location = as_dict(datacenter.get("location"))
    image = as_dict(server.get("image"))
    iso = as_dict(server.get("iso"))
    placement = as_dict(server.get("placement_group"))
    protection = as_dict(server.get("protection"))
    labels = {}
    for key, value in list(as_dict(server.get("labels")).items())[:MAX_LABELS]:
        labels[clip(key, 64)] = clip(value)
    return {
        "id": number(server.get("id")),
        "name": clip(server.get("name")),
        "status": clip(server.get("status"), 32),
        "created": clip(server.get("created"), 40),
        "locked": server.get("locked") is True,
        "backup_window": clip(server.get("backup_window"), 16),
        "outgoing_traffic": number(server.get("outgoing_traffic")),
        "ingoing_traffic": number(server.get("ingoing_traffic")),
        "included_traffic": number(server.get("included_traffic")),
        "rescue_enabled": server.get("rescue_enabled") is True,
        "public_net": {
            "ipv4": {"ip": clip(ipv4.get("ip"), 64), "dns_ptr": clip(ipv4.get("dns_ptr"))},
            "ipv6": {"ip": clip(ipv6.get("ip"), 64)},
            "firewalls": [{"status": clip(as_dict(f).get("status"), 32)}
                          for f in as_list(public_net.get("firewalls"))[:MAX_LABELS]],
        },
        "private_net": [{"ip": clip(as_dict(n).get("ip"), 64)}
                        for n in as_list(server.get("private_net"))[:MAX_LABELS]],
        "server_type": {
            "name": clip(server_type.get("name"), 32),
            "cores": number(server_type.get("cores")),
            "memory": number(server_type.get("memory")),
            "disk": number(server_type.get("disk")),
        },
        "datacenter": {
            "name": clip(datacenter.get("name"), 64),
            "location": {"city": clip(location.get("city"), 64),
                         "country": clip(location.get("country"), 8)},
        },
        "image": {
            "name": clip(image.get("name")),
            "description": clip(image.get("description")),
            "os_flavor": clip(image.get("os_flavor"), 32),
            "os_version": clip(image.get("os_version"), 32),
        },
        "iso": {"name": clip(iso.get("name")), "description": clip(iso.get("description"))} if iso else None,
        "placement_group": {"name": clip(placement.get("name"))} if placement else None,
        "protection": {"delete": protection.get("delete") is True,
                       "rebuild": protection.get("rebuild") is True},
        "labels": labels,
    }


def project_volume(raw):
    volume = as_dict(raw)
    return {
        "id": number(volume.get("id")),
        "server": number(volume.get("server")),
        "name": clip(volume.get("name")),
        "size": number(volume.get("size")),
        "linux_device": clip(volume.get("linux_device")),
        "format": clip(volume.get("format"), 32),
        "status": clip(volume.get("status"), 32),
    }


def project_box(raw):
    box = as_dict(raw)
    box_type = as_dict(box.get("storage_box_type"))
    location = as_dict(box.get("location"))
    stats = as_dict(box.get("stats"))
    access = as_dict(box.get("access_settings"))
    protection = as_dict(box.get("protection"))
    return {
        "id": number(box.get("id")),
        "username": clip(box.get("username"), 64),
        "status": clip(box.get("status"), 32),
        "name": clip(box.get("name")),
        "server": clip(box.get("server")),
        "system": clip(box.get("system"), 64),
        "created": clip(box.get("created"), 40),
        "snapshot_plan": bool(box.get("snapshot_plan")),
        "storage_box_type": {
            "name": clip(box_type.get("name"), 32),
            "description": clip(box_type.get("description"), 64),
            "size": number(box_type.get("size")),
            "snapshot_limit": number(box_type.get("snapshot_limit")),
        },
        "location": {"name": clip(location.get("name"), 32), "city": clip(location.get("city"), 64),
                     "country": clip(location.get("country"), 8)},
        "stats": {"size": number(stats.get("size")), "size_data": number(stats.get("size_data")),
                  "size_snapshots": number(stats.get("size_snapshots"))},
        "access_settings": {name: access.get(name) is True for name in (
            "ssh_enabled", "samba_enabled", "webdav_enabled", "zfs_enabled", "reachable_externally")},
        "protection": {"delete": protection.get("delete") is True},
    }


def attach_volumes(servers, volumes):
    """Project every record to the panel's shape and hang each volume off the
    server it is mounted on.

    The server object only carries volume ids, and the sizes and device paths
    are what anyone actually wants to see, so they are joined here rather than
    leaving the panel to do it.
    """
    by_server = {}
    for raw in volumes:
        volume = project_volume(raw)
        owner = volume.pop("server")
        if owner is None:
            continue
        by_server.setdefault(owner, []).append(volume)
    result = []
    for raw in servers:
        server = project_server(raw)
        server["attached_volumes"] = by_server.get(server["id"], [])
        result.append(server)
    return result


def api_error(error):
    """Turn an HTTP failure into something the panel can show verbatim."""
    if is_timeout(error):
        return 0, "Hetzner did not answer in time"
    if isinstance(error, urllib.error.HTTPError):
        status = error.code
        detail = ""
        try:
            body = json.loads(read_capped(error, MAX_ERROR_BODY, "API error body").decode("utf-8"))
            detail = clip((as_dict(as_dict(body).get("error")).get("message")) or "")
        except Exception:
            detail = ""
        if status == 401:
            return status, detail or "Token invalid or revoked"
        if status == 403:
            return status, detail or "Token lacks permission for this project"
        if status == 429:
            return status, detail or "Rate limited by Hetzner — try again shortly"
        if status >= 500:
            return status, detail or "Hetzner Cloud API is unavailable (%d)" % status
        return status, detail or "Hetzner Cloud API error %d" % status
    if isinstance(error, urllib.error.URLError):
        return 0, "No connection to api.hetzner.cloud (%s)" % error.reason
    return 0, str(error)


def project_entry(label):
    try:
        token = lookup_token(label)
    except ValueError as error:
        return {"label": label, "ok": False, "status": 0, "error": str(error), "servers": []}
    if token is None:
        return {
            "label": label,
            "ok": False,
            "status": 0,
            "error": "No token in the keyring for \"%s\"" % label,
            "servers": [],
        }
    try:
        # Three requests, side by side: the list, the volumes that hang off it
        # (one request per project, not per server), and the storage boxes from
        # the newer API on a different host. The answer takes as long as the
        # slowest of them, not the sum, and a token that cannot reach the box
        # host does not take the whole project down with it.
        done = in_parallel({
            "servers": lambda: fetch_all(SERVERS, token, "servers"),
            "volumes": lambda: fetch_all(VOLUMES, token, "volumes"),
            "storage_boxes": lambda: fetch_storage_boxes(token),
        })
        timings = {name: done[name][2] for name in done}
        servers, servers_error, _ = done["servers"]
        volumes, volumes_error, _ = done["volumes"]
        boxes, boxes_error, _ = done["storage_boxes"]
        if servers_error is not None:
            raise servers_error
        # Volumes are detail; the list is worth showing without them.
        if volumes_error is not None:
            volumes = []
        return {
            "label": label,
            "ok": True,
            "status": 200,
            "error": "",
            "servers": attach_volumes(servers, volumes),
            "storage_boxes": [project_box(box) for box in (boxes or [])],
            "storage_boxes_error": api_error(boxes_error)[1] if boxes_error is not None else "",
            "timings_ms": timings,
        }
    except Exception as error:  # noqa: BLE001 - every failure becomes panel text
        status, message = api_error(error)
        return {
            "label": label,
            "ok": False,
            "status": status,
            "error": message,
            "servers": [],
        }
    finally:
        del token


# -------------------------------------------------------------------- demo

def demo_fleet():
    return as_dict(as_dict(json.loads(read_file_capped(DEMO_FILE, MAX_DEMO_FILE, "demo file"))).get("projects"))


def demo_project(label):
    project = demo_fleet().get(label)
    if project is None:
        return {"label": label, "ok": False, "status": 0,
                "error": "No demo project named \"%s\"" % label, "servers": []}
    servers = json.loads(json.dumps(project.get("servers") or []))
    return {
        "label": label, "ok": True, "status": 200, "error": "",
        "servers": attach_volumes(servers, as_list(project.get("volumes"))),
        "storage_boxes": [project_box(box) for box in as_list(project.get("storage_boxes"))],
        "storage_boxes_error": "",
        "timings_ms": {"servers": 0, "volumes": 0, "storage_boxes": 0},
    }


def demo_metrics(server_id, window):
    """A plausible day in the life of a small web server, deterministic per id."""
    step = WINDOWS.get(window, 60)
    count = window // step + 1
    seed = int(server_id) % 97
    cpu = []
    for i in range(count):
        base = 9 + 5 * math.sin((i + seed) / 9.0) + 2 * math.sin((i * 3 + seed) / 4.0)
        spike = 38 if (i + seed) % 53 == 0 else 0
        cpu.append(round(max(0.4, base + spike), 2))
    return emit({"ok": True, "server": server_id, "window": window, "step": step,
                 "metrics": {"cpu": cpu[-1],
                             "network.0.bandwidth.in": 184320 + seed * 900,
                             "network.0.bandwidth.out": 1310720 + seed * 4000,
                             "disk.0.iops.read": 3 + seed % 7, "disk.0.iops.write": 41 + seed % 13},
                 "series": {"cpu": cpu}, "partial": "",
                 "timings_ms": {"cpu": 0, "network": 0, "disk": 0}})


def command_servers(labels):
    if not labels:
        return emit({"ok": True, "projects": []})
    if DEMO:
        return emit({"ok": True, "projects": [demo_project(label) for label in labels]})
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(WORKERS, len(labels))) as pool:
        projects = list(pool.map(project_entry, labels))
    return emit({"ok": True, "projects": projects})


def command_store(label):
    if DEMO:
        return fail("Demo data is on — nothing is stored")
    token = read_capped(sys.stdin.buffer, MAX_TOKEN, "token").decode("utf-8", "replace").strip()
    if not token or any(ch.isspace() for ch in token):
        return fail("No token on stdin" if not token else "A token has no whitespace in it")
    store_token(label, token)
    return emit({"ok": True, "label": label})


def command_remove(label):
    if DEMO:
        return fail("Demo data is on — nothing is removed")
    remove_token(label)
    return emit({"ok": True, "label": label})


def command_labels():
    if DEMO:
        return emit({"ok": True, "labels": sorted(demo_fleet().keys())})
    return emit({"ok": True, "labels": stored_labels()})


# ------------------------------------------------------------------ ssh sync

def ssh_block(hosts, user, key):
    """Render the managed block. Sorted so an unchanged fleet is byte-stable."""
    lines = [
        BLOCK_START,
        "# Managed by omarchy-hcloud. Edits inside this block are overwritten.",
    ]
    for host in sorted(hosts, key=lambda h: h["alias"]):
        lines.append("")
        lines.append("Host %s" % host["alias"])
        lines.append("    HostName %s" % host["ip"])
        if user:
            lines.append("    User %s" % user)
        if key:
            lines.append("    IdentityFile %s" % key)
    lines.append("")
    lines.append(BLOCK_END)
    return "\n".join(lines)


def apply_block(existing, block):
    """Splice the block into an existing config, replacing any previous one."""
    if BLOCK_RE.search(existing):
        return BLOCK_RE.sub(lambda _: block, existing, count=1)
    if existing.strip() == "":
        return block + "\n"
    separator = "" if existing.endswith("\n\n") else ("\n" if existing.endswith("\n") else "\n\n")
    return existing + separator + block + "\n"


def write_private(path, text):
    """Write 0600 and atomically, so a crash cannot leave a half config."""
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=directory, prefix=".hcloud-sync.")
    try:
        with os.fdopen(handle, "w") as out:
            out.write(text)
        os.chmod(temporary, stat.S_IRUSR | stat.S_IWUSR)
        os.replace(temporary, path)
    except BaseException:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise


# ------------------------------------------------------------------- metrics

# Hetzner reports load, throughput and IOPS, but never how full a disk is —
# that is only visible from inside the machine. `disk` here means I/O, not
# occupancy.
def metrics_series(token, server_id, kind, start, end, step):
    # Both halves of this need urlencode. An ISO timestamp ends in "+00:00",
    # and a raw plus in a query string means a space — Hetzner was being handed
    # a broken start and end every time.
    query = urllib.parse.urlencode({
        "type": kind,
        "start": start.isoformat(),
        "end": end.isoformat(),
        "step": step,
    })
    body = get_json("%s/%s/metrics?%s" % (SERVERS, server_id, query), token)
    return ((body.get("metrics") or {}).get("time_series")) or {}


# Window to step, chosen so a request lands somewhere near 120 points: dense
# enough to draw, small enough that the answer stays a few kilobytes. Verified
# against a real account — seven days at an hourly step returns 169 points, so
# Hetzner keeps at least that much history.
WINDOWS = {3600: 60, 86400: 900, 604800: 3600}


def command_metrics(label, server_id, window):
    if not str(server_id).isdigit():
        return fail("metrics needs a numeric server id")
    if DEMO:
        return demo_metrics(server_id, window)
    token = lookup_token(label)
    if token is None:
        return emit({"ok": False, "error": "No token in the keyring for \"%s\"" % label})
    step = WINDOWS.get(window, 60)
    end = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    start = end - datetime.timedelta(seconds=window)

    # One request per type. The documented way to ask for several at once is a
    # space-separated `type`, and Hetzner answers "invalid input in field
    # 'type'" to it; a single value is beyond argument. Three small requests,
    # side by side, and only for the row being looked at.
    latest, series, failures = {}, {}, []
    done = in_parallel({
        kind: (lambda k: lambda: metrics_series(token, server_id, k, start, end, step))(kind)
        for kind in ("cpu", "network", "disk")
    })
    timings = {name: done[name][2] for name in done}
    for kind in ("cpu", "network", "disk"):
        series_of, error, _ = done[kind]
        if error is not None:
            failures.append(api_error(error)[1])
            continue
        for name, entry in list(as_dict(series_of).items())[:16]:
            values = as_list(as_dict(entry).get("values"))[:MAX_SAMPLES]
            if not values:
                continue
            numbers = []
            for sample in values:
                try:
                    value = float(sample[1])
                except (TypeError, ValueError, IndexError):
                    continue
                if math.isfinite(value):
                    numbers.append(value)
            if not numbers:
                continue
            name = clip(name, 64)
            latest[name] = numbers[-1]
            # Only the cpu curve is drawn, so only it is worth carrying back.
            if name == "cpu":
                series[name] = numbers
    del token

    # One type failing is worth saying, but not worth throwing the others away.
    if not latest and failures:
        return emit({"ok": False, "error": failures[0]})
    return emit({"ok": True, "server": server_id, "window": window, "step": step,
                 "metrics": latest, "series": series,
                 "partial": failures[0] if failures else "",
                 "timings_ms": timings})


# -------------------------------------------------------------- storage boxes

def fetch_storage_boxes(token):
    return fetch_all(STORAGE_BOXES, token, "storage_boxes",
                     timeout=BOX_TIMEOUT, attempts=BOX_ATTEMPTS)


def command_storage_boxes(label):
    if DEMO:
        return emit({"ok": True, "boxes": demo_project(label).get("storage_boxes") or []})
    token = lookup_token(label)
    if token is None:
        return emit({"ok": False, "error": "No token in the keyring for \"%s\"" % label})
    try:
        return emit({"ok": True, "boxes": [project_box(box) for box in fetch_storage_boxes(token)]})
    except Exception as error:  # noqa: BLE001
        status, message = api_error(error)
        return emit({"ok": False, "status": status, "error": message})
    finally:
        del token


def valid_ip(value):
    try:
        ipaddress.ip_address(value)
    except ValueError:
        return False
    return True


def read_sync_job():
    """Parse and validate the job on stdin, or raise ValueError saying why.

    Refusing the whole job is deliberate: silently dropping one bad host would
    delete it from the config, which is the failure the sync is built to avoid.
    """
    raw = read_capped(sys.stdin.buffer, MAX_STDIN, "sync job").decode("utf-8", "replace")
    try:
        job = json.loads(raw or "{}")
    except ValueError:
        raise ValueError("sync-ssh expects a JSON object on stdin")
    if not isinstance(job, dict):
        raise ValueError("sync-ssh expects a JSON object on stdin")
    raw_hosts = job.get("hosts") or []
    if not isinstance(raw_hosts, list):
        raise ValueError("sync-ssh expects a list of hosts")
    user = str(job.get("user") or "")
    key = str(job.get("key") or "")
    if not NO_WHITESPACE_RE.match(user):
        raise ValueError("SSH user must not contain whitespace")
    if not NO_WHITESPACE_RE.match(key):
        raise ValueError("SSH identity file must not contain whitespace")
    hosts = []
    for entry in raw_hosts:
        if not isinstance(entry, dict):
            raise ValueError("sync-ssh expects each host to be an object")
        alias = str(entry.get("alias") or "")
        ip = str(entry.get("ip") or "")
        # A server without a public IPv4 has nothing to write; the panel
        # already leaves those out, and the bridge agrees rather than argues.
        if not alias or not ip:
            continue
        if not ALIAS_RE.match(alias):
            raise ValueError("Refusing to write %r as an ssh Host" % alias)
        if not valid_ip(ip):
            raise ValueError("Refusing to write %r as a HostName for %s" % (ip, alias))
        hosts.append({"alias": alias, "ip": ip})
    return hosts, user, key


def command_sync_ssh():
    try:
        hosts, user, key = read_sync_job()
    except ValueError as error:
        return fail(str(error))

    existing = ""
    if os.path.exists(SSH_CONFIG):
        existing = read_file_capped(SSH_CONFIG, MAX_SSH_CONFIG, SSH_CONFIG)

    # A start marker with no end marker means someone edited the block by hand
    # and left it open. Splicing into that would swallow the rest of the file,
    # so stop and say so instead.
    if BLOCK_START in existing and not BLOCK_RE.search(existing):
        return emit({
            "ok": False,
            "error": "%s has an unterminated hcloud-sync block — fix it by hand" % SSH_CONFIG,
        })

    updated = apply_block(existing, ssh_block(hosts, user, key))
    if updated == existing:
        # Nothing to do. Returning early keeps the refresh cycle from rewriting
        # the file — and rolling the backup — once a minute forever.
        return emit({"ok": True, "changed": False, "hosts": len(hosts), "path": SSH_CONFIG})

    if existing != "":
        write_private(SSH_BACKUP, existing)
    write_private(SSH_CONFIG, updated)
    return emit({
        "ok": True,
        "changed": True,
        "hosts": len(hosts),
        "path": SSH_CONFIG,
        "backup": SSH_BACKUP if existing != "" else "",
    })


def command_uninstall():
    """Everything the plugin left outside its own directory, taken back.

    `omarchy plugin remove` deletes the checkout and knows nothing else. The
    tokens in the keyring and the block in ~/.ssh/config are the two things
    that would otherwise stay behind.
    """
    removed_block = False
    if os.path.exists(SSH_CONFIG):
        existing = read_file_capped(SSH_CONFIG, MAX_SSH_CONFIG, SSH_CONFIG)
        if BLOCK_RE.search(existing):
            updated = BLOCK_RE.sub("", existing, count=1)
            updated = re.sub(r"\n{3,}", "\n\n", updated).lstrip("\n")
            write_private(SSH_BACKUP, existing)
            write_private(SSH_CONFIG, updated)
            removed_block = True
    labels, warning = [], ""
    try:
        labels = stored_labels()
        for label in labels:
            remove_token(label)
    except RuntimeError as error:
        warning = str(error)
    return emit({"ok": True, "tokens_removed": labels, "ssh_block_removed": removed_block,
                 "backup": SSH_BACKUP if removed_block else "", "warning": warning})


def main(argv):
    global DEMO
    if "--demo" in argv:
        DEMO = True
        argv = [arg for arg in argv if arg != "--demo"]
    if not argv:
        return fail("Usage: omarchy-hcloud-bridge servers|store|remove|labels|sync-ssh|metrics|storage-boxes|uninstall")
    command, args = argv[0], argv[1:]
    try:
        if command == "servers":
            return command_servers(args)
        if command == "store":
            if not args:
                return fail("store needs a label")
            return command_store(args[0])
        if command == "remove":
            if not args:
                return fail("remove needs a label")
            return command_remove(args[0])
        if command == "labels":
            return command_labels()
        if command == "sync-ssh":
            return command_sync_ssh()
        if command == "metrics":
            if len(args) < 2:
                return fail("metrics needs a label and a server id")
            window = int(args[2]) if len(args) > 2 and args[2].isdigit() else 3600
            if window not in WINDOWS:
                window = 3600
            return command_metrics(args[0], args[1], window)
        if command == "storage-boxes":
            if not args:
                return fail("storage-boxes needs a label")
            return command_storage_boxes(args[0])
        if command == "uninstall":
            if DEMO:
                return fail("Demo data is on — nothing to uninstall")
            return command_uninstall()
    except (RuntimeError, ValueError) as error:
        return fail(str(error))
    except subprocess.CalledProcessError as error:
        return fail((error.stderr or "").strip() or "secret-tool failed")
    except OSError as error:
        return fail(str(error))
    except Exception as error:  # noqa: BLE001 - the panel shows stdout, never a traceback
        return fail("%s: %s" % (type(error).__name__, error))
    return fail("Unknown command: %s" % command)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
